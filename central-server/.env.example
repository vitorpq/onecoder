# Chaves internas do LiteLLM Proxy (gere valores aleatorios fortes em producao)
LITELLM_MASTER_KEY=sk-master-troque-esta-chave
LITELLM_SALT_KEY=sk-salt-troque-esta-chave

# Banco de dados do LiteLLM (armazena virtual keys, orcamentos e logs de uso)
POSTGRES_USER=litellm
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=litellm

# Chaves das APIs externas (conta centralizada da empresa)
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=AIza...

# Porta HTTP do Gateway de IA
LITELLM_PORT=4000
